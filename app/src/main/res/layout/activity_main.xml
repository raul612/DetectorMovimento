<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detector de Movimento"
            android:textColor="#1C2541"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Valores capturados pelo acelerômetro"
            android:textColor="#596579"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eixo X"
            android:textColor="#1C2541"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/eixoX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0.00 m/s²"
            android:textColor="#018E3E"
            android:textSize="24sp"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eixo Y"
            android:textColor="#1C2541"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/eixoY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0.00 m/s²"
            android:textColor="#018E3E"
            android:textSize="24sp"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eixo Z"
            android:textColor="#1C2541"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/eixoZ"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0.00 m/s²"
            android:textColor="#018E3E"
            android:textSize="24sp"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/statusSensor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verificando acelerômetro..."
            android:textColor="#1C2541"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="18dp"
            android:background="#E2E8F0" />

    </LinearLayout>
</ScrollView>
